# LLM used by the interview pipeline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:3000

# LangSmith evaluation and tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=askly-agent-eval

# Optional: use a different model for LLM-as-a-Judge
EVAL_JUDGE_MODEL=gpt-4o-mini
